# Copie para .env e ajuste conforme necessário (o .env real não é versionado).

# Caminho do arquivo de pesos do modelo YOLO, relativo ao diretório de trabalho.
MODEL_PATH=models/yolo11n.pt

# Vídeo de entrada: um arquivo local ou uma URL de stream (ex.: câmera IP do celular).
VIDEO_SOURCE=samples/teste.mp4

# Exibe (ou não) a janela de vídeo com as detecções. Deve ficar "false" dentro
# de containers (sem display); pode ser "true" rodando localmente sem Docker.
SHOW_VIDEO=false

# Diretório onde os resultados de inferência (vídeos/imagens anotados) são salvos.
OUTPUT_DIR=outputs/runs/detect
