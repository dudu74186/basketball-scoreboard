# --- Mídia e artefatos pesados (não versionar) ---
*.mp4
*.avi
*.mov
*.mkv
*.webm
# Downloads em andamento: o yt-dlp grava como "<nome>.mp4.part", que NAO
# casa com *.mp4 e por isso escapava do ignore (um .part de 667MB chegou a
# ser recusado pelo GitHub, que limita arquivos a 100MB).
*.part
*.ytdl
*.pt
*.onnx
runs/
# Datasets de treino: milhares de imagens, rebaixáveis com
# ia/treino/baixar_dataset.py.
datasets/
# Saídas de treino e inferência: pesos, curvas, logs e imagens de batch.
# São artefatos gerados — reproduzíveis rodando o treino de novo. As
# métricas que importam ficam registradas no diário do projeto.
ia/outputs/
# Vídeos anotados para revisão humana. Também gerados; a estrutura das
# pastas está documentada em ia/treino/README.md.
ia/revisao/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Node / TypeScript (frontend, Fase 5) ---
node_modules/
dist/
build/
.env
.env.local

# --- Rust (backend, Fase 4) ---
# Sem barra no início: ignora target/ em qualquer nível (backend/target/
# também). Com "/target/" só a raiz do repo seria coberta.
target/
# Cargo.lock NÃO entra aqui de propósito: para aplicações (binários), a
# recomendação oficial do Rust é versionar o lock, garantindo que Linux,
# Windows, Docker e CI compilem exatamente as mesmas versões. Só bibliotecas
# é que o ignoram.

# --- Editor / SO ---
.obsidian/
.directory
.vscode/
.idea/
*.swp

# --- Segredos (nunca versionar) ---
*.pem
*.key
secrets/
