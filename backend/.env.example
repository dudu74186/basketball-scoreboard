# Copie para .env (não versionado) e ajuste os valores.

# Conexão com o PostgreSQL do docker-compose.yml. Rodando o backend na
# máquina (fora do Docker), o host é localhost; quando o backend virar um
# serviço do compose, passa a ser o nome do serviço: db.
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/BANCO

# Onde a API escuta. Deixe em 127.0.0.1 para uso local (não exposta na rede).
# Dentro de um container precisa ser 0.0.0.0:3000 para aceitar conexões.
BIND_ADDR=127.0.0.1:3000
